{
  "name": "lisiere-compact",
  "version": "1.4.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/epub.test.ts && node --import tsx tests/reader.test.ts",
    "build:bundled": "node scripts/build-web-features.cjs",
    "preview:bundled": "node scripts/preview.cjs",
    "test:features": "node --test tests/features.test.cjs"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-status-bar": "~3.0.9",
    "fast-xml-parser": "^5.3.6",
    "htmlparser2": "^10.0.0",
    "jszip": "^3.10.1",
    "lucide-react-native": "^1.61.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.10",
    "@playwright/test": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
